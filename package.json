{
  "name": "book360",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "media:prepare": "node scripts/prepare-media.mjs",
    "test:e2e": "playwright test",
    "qa:screens": "node scripts/capture-pages.mjs",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "bench": "node --expose-gc scripts/bench-catalogue.mjs"
  },
  "dependencies": {
    "marzipano": "0.10.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "license": "Apache-2.0"
}
